# TOON v3.0 - Architecture Contract
# SPEC-019; comportamento aprovado preservado; estimate-lines 450 incluindo margem 70
contract:
  feature-ref: FT-019
  version: 1.0

layers:
  detection:
    files[4]{path,action,description}:
      core-detection/src/main/kotlin/io/github/valossa515/tapguard/core/detection/signal/KnownCloneApps.kt,create,BR-001 e BR-002; object publico; Set<String> nao modificavel; sete fontes por entrada
      core-detection/src/main/kotlin/io/github/valossa515/tapguard/core/detection/signal/InstallSourceCollector.kt,modify,BR-003 a BR-010; tres parametros obrigatorios copiados; predicado aprovado e KDoc
      core-detection/src/main/kotlin/io/github/valossa515/tapguard/core/detection/signal/KnownBanks.kt,modify,BR-009; KDoc documenta derivacao dos pacotes para S1
      core-detection/src/main/kotlin/io/github/valossa515/tapguard/core/detection/signal/TrustedStores.kt,modify,BR-010; KDoc remete a excecao estreita sem mudar a lista
