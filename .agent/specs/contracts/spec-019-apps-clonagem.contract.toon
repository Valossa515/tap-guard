migrations[0]:

dependencies:
  uses[5]:
    InstalledApp e Signal e SignalCollector do core-domain
    anInstalledApp do testFixtures do core-domain
    TrustedStores e KnownBanks e KnownWallets como padroes existentes
    java.util.Collections e LinkedHashSet do JDK
    JUnit 4 e kotlinx.coroutines.test.runTest ja no modulo
  introduces[0]:

test-strategy:
  unit-tests:
    - target: KnownCloneApps
      scenarios[2]:
        conteudo-exato-contra-sete-literais-independentes
        mutacao-por-cast-lanca-UnsupportedOperationException-e-preserva-conteudo
    - target: InstallSourceCollector
      scenarios[8]:
        sete-clonadores-com-banco-sem-S1-e-com-app-comum-S1
        banco-manual-nulo-desconhecido-shell-e-instaladores-do-sistema-S1
        ShareMe-SHAREit-Lite-e-MIUI-Backup-com-banco-S1
        variacao-de-caixa-isolada-do-banco-e-do-clonador-e-rotulo-sem-pacote-S1
        vazios-independentes-lojas-vazias-e-todos-vazios
        configuracao-ficticia-ampliada-e-reduzida
        tres-conjuntos-copiados-contra-remocao-e-adicao
        todos-os-testes-antigos-e-onze-lojas-com-banco-e-nao-banco
  integration-tests:
  verification[6]{criterion,how}:
    AC-001 e AC-004,Inspecionar object e fontes e tres parametros obrigatorios sem overload antigo
    AC-014 e AC-017,Revisar documentacao e responsabilidade Hilt na SPEC-018
    AC-005,Mutacoes locais retiram copia de cada conjunto e devem derrubar testes; restaurar sem commit
    AC-007 e AC-008 e AC-011,Mutacoes locais trocam E por OU e ignoram caixa e devem derrubar testes; restaurar sem commit
    AC-002 e AC-008 e AC-016,Mutacao local inclui clonadores em TrustedStores e deve derrubar testes; restaurar sem commit
    AC-015 e AC-018,Build do modulo e build completo com lint e testes; validar SDD; revisar diff sem mudancas de dominio ou dependencias
  excluded[3]{target,reason}:
    Hilt e derivacao real de KnownBanks.apps,SPEC-018
    Atribuicao de instalador no aparelho,SPEC-022
    Motor e persistencia,Sem alteracao nesta spec; suites existentes permanecem
